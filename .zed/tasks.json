[
  {
    "label": "serve",
    "command": "bundle exec jekyll serve -H 0.0.0.0 --limit_posts 3",
    "use_new_terminal": true
  },
  {
    "label": "new article",
    "command": "python3 tools/new_article.py",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always"
  }
]
